@{ ViewData["Title"] = "Quản trị"; Layout = "/Views/Shared/_Layout.cshtml"; }
<h1>Quản trị BakeryShop</h1><nav class="d-flex flex-wrap gap-2 my-3"><a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Products" asp-action="Index">Sản phẩm</a><a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Categories" asp-action="Index">Danh mục</a><a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Orders" asp-action="Index">Đơn hàng</a><a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Customers" asp-action="Index">Khách hàng</a><a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Contacts" asp-action="Index">Liên hệ</a><a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="News" asp-action="Index">Tin tức</a></nav>
<div class="row g-3"><div class="col-md-3"><div class="paper-card"><strong>Sản phẩm</strong><h2>@ViewBag.ProductCount</h2></div></div><div class="col-md-3"><div class="paper-card"><strong>Đơn hàng</strong><h2>@ViewBag.OrderCount</h2></div></div><div class="col-md-3"><div class="paper-card"><strong>Khách hàng</strong><h2>@ViewBag.CustomerCount</h2></div></div><div class="col-md-3"><div class="paper-card"><strong>Doanh thu</strong><h2>@(((decimal)ViewBag.Revenue).ToString("N0"))đ</h2></div></div></div>
<h2 class="mt-4">Đơn hàng mới nhất</h2><table class="table"><thead><tr><th>Mã</th><th>Khách hàng</th><th>Tổng</th><th>Trạng thái</th></tr></thead><tbody>@foreach(BakeryShop.Models.Entities.Order order in ViewBag.Orders){<tr><td>@order.OrderNumber</td><td>@order.CustomerName</td><td>@order.TotalAmount.ToString("N0")đ</td><td>@order.Status</td></tr>}</tbody></table>
<h2 class="mt-4">Doanh thu theo tháng</h2><div class="paper-card"><canvas id="revenueChart"></canvas></div>
@section Scripts { <script src="https://cdn.jsdelivr.net/npm/chart.js"></script><script>
const revenueLabels = @Html.Raw((string)ViewBag.ChartLabels);
const revenueValues = @Html.Raw((string)ViewBag.ChartValues);
new Chart(document.getElementById('revenueChart'), { type: 'bar', data: { labels: revenueLabels, datasets: [{ label: 'Doanh thu (đ)', data: revenueValues, backgroundColor: '#a9754d' }] }, options: { responsive: true } });
</script> }
