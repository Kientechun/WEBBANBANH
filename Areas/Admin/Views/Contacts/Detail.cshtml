@model BakeryShop.Models.Entities.Contact
@{ ViewData["Title"] = "Chi tiết liên hệ"; Layout = "/Views/Shared/_Layout.cshtml"; }
<h1>@Model.Subject</h1><div class="paper-card mb-3"><p>@Model.Name · @Model.Email · @Model.Phone</p><p>@Model.Message</p></div><form asp-action="UpdateStatus" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><select name="status" class="form-select d-inline-block w-auto"><option value="new">Mới</option><option value="processing">Đang xử lý</option><option value="completed">Hoàn tất</option></select><button class="btn btn-brown">Cập nhật trạng thái</button></form><form asp-action="Delete" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-outline-danger">Xóa</button></form>
