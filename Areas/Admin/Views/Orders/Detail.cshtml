@model BakeryShop.Models.Entities.Order
@{ ViewData["Title"] = "Chi tiết đơn"; Layout = "/Views/Shared/_Layout.cshtml"; }
<h1>Đơn @Model.OrderNumber</h1><div asp-validation-summary="All" class="text-danger"></div><div class="paper-card mb-3"><p>@Model.CustomerName · @Model.CustomerPhone · @Model.CustomerEmail</p><p>@Model.CustomerAddress</p>@foreach(var item in Model.Items){<div>@item.ProductName × @item.Quantity — @item.Subtotal.ToVnd()</div>}<strong>Tổng: @Model.TotalAmount.ToVnd()</strong></div>
<form asp-action="Update" method="post" class="paper-card col-lg-7">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><label class="form-label">Trạng thái đơn</label><select class="form-select mb-3" name="status">@foreach(var s in new[]{"pending","confirmed","processing","shipping","completed","cancelled"}){<option selected="@(Model.Status == s)" value="@s">@s</option>}</select><label class="form-label">Thanh toán</label><select class="form-select mb-3" name="paymentStatus"><option selected="@(Model.PaymentStatus=="unpaid")" value="unpaid">Chưa thanh toán</option><option selected="@(Model.PaymentStatus=="paid")" value="paid">Đã thanh toán</option></select><label class="form-label">Ghi chú quản trị</label><textarea class="form-control mb-3" name="adminNotes">@Model.AdminNotes</textarea><button class="btn btn-brown">Cập nhật</button></form>
