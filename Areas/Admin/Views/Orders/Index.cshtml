@model IReadOnlyList<BakeryShop.Models.Entities.Order>
@{ ViewData["Title"] = "Đơn hàng"; Layout = "/Views/Shared/_Layout.cshtml"; }
<h1>Quản lý đơn hàng</h1><form class="row g-2 mb-3"><div class="col-md-4"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Mã đơn, khách hàng, số điện thoại" /></div><div class="col-md-3"><select class="form-select" name="status"><option value="">Tất cả trạng thái</option>@foreach(var s in new[]{"pending","confirmed","processing","shipping","completed","cancelled"}){<option selected="@(ViewBag.Status as string == s)" value="@s">@s</option>}</select></div><div class="col"><button class="btn btn-brown">Lọc</button></div></form>
<div class="table-responsive"><table class="table"><thead><tr><th>Mã</th><th>Khách hàng</th><th>Điện thoại</th><th>Tổng</th><th>Đơn hàng</th><th>Thanh toán</th><th></th></tr></thead><tbody>@foreach(var o in Model){<tr><td>@o.OrderNumber</td><td>@o.CustomerName</td><td>@o.CustomerPhone</td><td>@o.TotalAmount.ToVnd()</td><td>@o.Status</td><td>@o.PaymentStatus</td><td><a asp-action="Detail" asp-route-id="@o.Id">Chi tiết</a></td></tr>}</tbody></table></div>
