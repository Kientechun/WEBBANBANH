@model BakeryShop.Models.Entities.News
@{ ViewData["Title"] = Model.Id == 0 ? "Thêm bài viết" : "Sửa bài viết"; Layout = "/Views/Shared/_Layout.cshtml"; var action = Model.Id == 0 ? "Create" : "Edit"; }
<h1>@ViewData["Title"]</h1><form asp-action="@action" method="post" enctype="multipart/form-data" class="paper-card col-lg-8">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="text-danger"></div><label class="form-label">Tiêu đề</label><input asp-for="Title" class="form-control mb-3" /><label class="form-label">Tóm tắt</label><textarea asp-for="Summary" class="form-control mb-3"></textarea><label class="form-label">Nội dung</label><textarea asp-for="Content" class="form-control mb-3" rows="8"></textarea><label class="form-label">Tác giả</label><input asp-for="Author" class="form-control mb-3" /><label class="form-label">Ảnh (JPG/PNG/WebP, tối đa 2MB)</label><input type="file" name="imageFile" class="form-control mb-3" /><div class="form-check mb-3"><input asp-for="Status" class="form-check-input" /><label asp-for="Status" class="form-check-label">Đăng bài</label></div><button class="btn btn-brown">Lưu</button></form>
