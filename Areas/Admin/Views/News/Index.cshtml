@model IReadOnlyList<BakeryShop.Models.Entities.News>
@{ ViewData["Title"] = "Tin tức"; Layout = "/Views/Shared/_Layout.cshtml"; }
<div class="d-flex justify-content-between"><h1>Tin tức</h1><a class="btn btn-brown" asp-action="Create">Thêm bài viết</a></div><table class="table"><thead><tr><th>Tiêu đề</th><th>Tác giả</th><th>Ngày</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Title</td><td>@item.Author</td><td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td>@(item.Status?"Đã đăng":"Bản nháp")</td><td><a asp-action="Edit" asp-route-id="@item.Id">Sửa</a><form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-link text-danger">Xóa</button></form></td></tr>}</tbody></table>
