@model IReadOnlyList<BakeryShop.Models.Entities.User>
@{ ViewData["Title"] = "Khách hàng"; Layout = "/Views/Shared/_Layout.cshtml"; }
<h1>Khách hàng</h1><form class="mb-3"><input class="form-control d-inline-block w-auto" name="search" placeholder="Tên, email, điện thoại" /><button class="btn btn-brown">Tìm</button></form><table class="table"><thead><tr><th>Họ tên</th><th>Email</th><th>Điện thoại</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var u in Model){<tr><td>@u.Name</td><td>@u.Email</td><td>@u.Phone</td><td>@(u.Status?"Hoạt động":"Đã khóa")</td><td><form asp-action="ToggleStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id" /><button class="btn btn-sm btn-outline-secondary">@(u.Status?"Khóa":"Mở khóa")</button></form></td></tr>}</tbody></table>
