@model IReadOnlyList<BakeryShop.Models.Entities.Category>
@{ ViewData["Title"] = "Danh mục"; Layout = "/Views/Shared/_Layout.cshtml"; }
<div class="d-flex justify-content-between"><h1>Danh mục</h1><a class="btn btn-brown" asp-action="Create">Thêm danh mục</a></div><table class="table"><thead><tr><th>Tên</th><th>Slug</th><th>Thứ tự</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.Name</td><td>@c.Slug</td><td>@c.DisplayOrder</td><td>@(c.Status?"Đang dùng":"Ẩn")</td><td><a asp-action="Edit" asp-route-id="@c.Id">Sửa</a><form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-link text-danger" onclick="return confirm('Xóa danh mục? Sản phẩm thuộc danh mục cũng sẽ bị xóa.')">Xóa</button></form></td></tr>}</tbody></table>
