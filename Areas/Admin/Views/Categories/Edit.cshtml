@model BakeryShop.Models.Entities.Category
@{ ViewData["Title"] = Model.Id == 0 ? "Thêm danh mục" : "Sửa danh mục"; Layout = "/Views/Shared/_Layout.cshtml"; var action = Model.Id == 0 ? "Create" : "Edit"; }
<h1>@ViewData["Title"]</h1><form asp-action="@action" method="post" class="paper-card col-md-7">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="text-danger"></div><label class="form-label">Tên danh mục</label><input asp-for="Name" class="form-control mb-3" /><label class="form-label">Mô tả</label><textarea asp-for="Description" class="form-control mb-3"></textarea><label class="form-label">Thứ tự hiển thị</label><input asp-for="DisplayOrder" class="form-control mb-3" /><div class="form-check mb-3"><input asp-for="Status" class="form-check-input" /><label asp-for="Status" class="form-check-label">Đang hoạt động</label></div><button class="btn btn-brown">Lưu</button></form>
