@model BakeryShop.ViewModels.AdminProductViewModel
@{ ViewData["Title"] = Model.Id == 0 ? "Thêm sản phẩm" : "Sửa sản phẩm"; Layout = "/Views/Shared/_Layout.cshtml"; var action = Model.Id == 0 ? "Create" : "Edit"; }
<h1>@ViewData["Title"]</h1><form asp-action="@action" method="post" enctype="multipart/form-data" class="paper-card col-lg-8">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><input asp-for="ExistingImage" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<label asp-for="Name" class="form-label">Tên sản phẩm</label><input asp-for="Name" class="form-control mb-3" />
<label asp-for="CategoryId" class="form-label">Danh mục</label><select asp-for="CategoryId" asp-items="Model.Categories" class="form-select mb-3"><option value="">Chọn danh mục</option></select>
<div class="row"><div class="col"><label asp-for="Price" class="form-label">Giá</label><input asp-for="Price" class="form-control mb-3" /></div><div class="col"><label asp-for="SalePrice" class="form-label">Giá khuyến mãi</label><input asp-for="SalePrice" class="form-control mb-3" /></div><div class="col"><label asp-for="Stock" class="form-label">Tồn kho</label><input asp-for="Stock" class="form-control mb-3" /></div></div>
<label asp-for="Description" class="form-label">Mô tả</label><textarea asp-for="Description" class="form-control mb-3"></textarea><label asp-for="Ingredients" class="form-label">Thành phần</label><textarea asp-for="Ingredients" class="form-control mb-3"></textarea><label asp-for="ImageFile" class="form-label">Ảnh (JPG/PNG/WebP, tối đa 2MB)</label><input asp-for="ImageFile" type="file" class="form-control mb-3" /><span asp-validation-for="ImageFile" class="text-danger"></span>
<div class="form-check"><input asp-for="IsFeatured" class="form-check-input" /><label asp-for="IsFeatured" class="form-check-label">Nổi bật</label></div><div class="form-check"><input asp-for="IsNew" class="form-check-input" /><label asp-for="IsNew" class="form-check-label">Sản phẩm mới</label></div><div class="form-check"><input asp-for="IsBestseller" class="form-check-input" /><label asp-for="IsBestseller" class="form-check-label">Bán chạy</label></div><div class="form-check mb-3"><input asp-for="Status" class="form-check-input" /><label asp-for="Status" class="form-check-label">Đang bán</label></div><button class="btn btn-brown">Lưu</button><a asp-action="Index" class="btn btn-outline-secondary">Hủy</a></form>
