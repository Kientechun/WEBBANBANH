@model IReadOnlyList<BakeryShop.Models.Entities.Product>
@{ ViewData["Title"] = "Quản lý sản phẩm"; Layout = "/Views/Shared/_Layout.cshtml"; }
<div class="d-flex justify-content-between"><h1>Sản phẩm</h1><a class="btn btn-brown" asp-action="Create">Thêm sản phẩm</a></div><form class="my-3"><input class="form-control d-inline-block w-auto" name="search" value="@ViewBag.Search" placeholder="Tìm tên bánh" /><button class="btn btn-outline-secondary">Tìm</button></form>
<div class="table-responsive"><table class="table"><thead><tr><th>Tên</th><th>Danh mục</th><th>Giá</th><th>Tồn kho</th><th>Hiển thị</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Name</td><td>@p.Category.Name</td><td>@p.Price.ToString("N0")đ</td><td>@p.Stock</td><td>@(p.Status?"Có":"Không")</td><td><a asp-action="Edit" asp-route-id="@p.Id">Sửa</a> <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-link text-danger" onclick="return confirm('Xóa sản phẩm này?')">Xóa</button></form></td></tr>}</tbody></table></div>
