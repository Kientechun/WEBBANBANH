@model BakeryShop.Models.Entities.Product
<div class="col-6 col-md-4 col-lg-3"><article class="card product-card h-100"><a asp-controller="Products" asp-action="Detail" asp-route-slug="@Model.Slug"><img src="@(Model.Image ?? "/images/cake-placeholder.svg")" class="card-img-top product-image" alt="@Model.Name" /></a><div class="card-body"><div class="small text-muted">@Model.Category?.Name</div><h5 class="card-title"><a asp-controller="Products" asp-action="Detail" asp-route-slug="@Model.Slug">@Model.Name</a></h5><strong class="price">@((Model.SalePrice ?? Model.Price).ToVnd())</strong>@if(Model.SalePrice.HasValue){<del class="small text-muted ms-2">@Model.Price.ToVnd()</del>}<div class="d-flex flex-wrap gap-1 align-items-center"><a class="btn btn-brown btn-sm mt-2" asp-controller="Products" asp-action="Detail" asp-route-slug="@Model.Slug">Xem bánh</a><button type="button" class="btn btn-outline-secondary btn-sm mt-2 quick-add" data-id="@Model.Id" disabled="@(Model.Stock <= 0)">+ Giỏ</button></div><div class="small text-success quick-msg"></div></div></article></div>
