@model BakeryShop.ViewModels.ChangePasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<h1>Đổi mật khẩu</h1><form asp-action="ChangePassword" method="post" class="paper-card col-md-6">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><label asp-for="CurrentPassword" class="form-label">Mật khẩu hiện tại</label><input asp-for="CurrentPassword" class="form-control mb-3" /><label asp-for="NewPassword" class="form-label">Mật khẩu mới</label><input asp-for="NewPassword" class="form-control mb-3" /><label asp-for="ConfirmPassword" class="form-label">Nhập lại mật khẩu mới</label><input asp-for="ConfirmPassword" class="form-control mb-3" /><button class="btn btn-brown">Đổi mật khẩu</button></form>
