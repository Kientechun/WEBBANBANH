@model BakeryShop.Models.Entities.User
@{ ViewData["Title"] = "Tài khoản"; var orders = (IEnumerable<BakeryShop.Models.Entities.Order>)ViewBag.Orders; }
<h1>Xin chào, @Model.Name</h1><div class="paper-card mb-4"><p>Email: @Model.Email</p><p>Điện thoại: @(Model.Phone ?? "Chưa cập nhật")</p><p>Địa chỉ: @(Model.Address ?? "Chưa cập nhật")</p><a asp-action="Profile">Cập nhật hồ sơ</a> · <a asp-action="ChangePassword">Đổi mật khẩu</a></div><h2>Lịch sử đơn hàng</h2><div class="table-responsive"><table class="table"><thead><tr><th>Mã đơn</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var order in orders){<tr><td>@order.OrderNumber</td><td>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td>@order.TotalAmount.ToString("N0")đ</td><td>@order.Status</td><td>@if(order.Status=="pending"){<form asp-action="CancelOrder" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@order.Id" /><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Hủy đơn hàng này?')">Hủy đơn</button></form>}</td></tr>}</tbody></table></div>
