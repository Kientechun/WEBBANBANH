@{ ViewData["Title"] = "Quên mật khẩu"; }
<h1>Khôi phục mật khẩu</h1><div class="paper-card col-md-6">@if(TempData["Message"] is string msg){<p>@msg</p>}<form asp-action="ForgotPassword" method="post">@Html.AntiForgeryToken()<label class="form-label">Email tài khoản</label><input class="form-control mb-3" type="email" name="email" required /><button class="btn btn-brown">Gửi yêu cầu</button></form><small class="d-block mt-2">Liên hệ cửa hàng để được hỗ trợ đặt lại mật khẩu.</small></div>
