@model BakeryShop.ViewModels.ProfileViewModel
@{ ViewData["Title"] = "Cập nhật hồ sơ"; }
<h1>Cập nhật hồ sơ</h1><form asp-action="Profile" method="post" enctype="multipart/form-data" class="paper-card col-lg-7">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><label asp-for="Name" class="form-label">Họ tên</label><input asp-for="Name" class="form-control mb-3" /><label asp-for="Phone" class="form-label">Điện thoại</label><input asp-for="Phone" class="form-control mb-3" /><label asp-for="Address" class="form-label">Địa chỉ</label><textarea asp-for="Address" class="form-control mb-3"></textarea><label asp-for="AvatarFile" class="form-label">Ảnh đại diện (JPG/PNG/WebP, tối đa 2MB)</label><input asp-for="AvatarFile" type="file" class="form-control mb-3" /><button class="btn btn-brown">Lưu thay đổi</button></form>
