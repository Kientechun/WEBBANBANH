@model BakeryShop.ViewModels.ProductListViewModel
@{ ViewData["Title"] = "Sản phẩm"; }
<h1 class="mb-4">Bánh ngon mỗi ngày</h1>
<form class="row g-2 mb-4" method="get"><div class="col-md-3"><input class="form-control" name="search" value="@Model.Search" placeholder="Tên bánh" /></div><div class="col-md-2"><select class="form-select" name="categoryId"><option value="">Tất cả danh mục</option>@foreach(var c in Model.Categories){<option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>}</select></div><div class="col-md-2"><input class="form-control" type="number" name="minPrice" value="@Model.MinPrice" placeholder="Giá từ" /></div><div class="col-md-2"><input class="form-control" type="number" name="maxPrice" value="@Model.MaxPrice" placeholder="Giá đến" /></div><div class="col-md-2"><select class="form-select" name="sort"><option value="newest">Mới nhất</option><option value="price-asc" selected="@(Model.Sort == "price-asc")">Giá tăng dần</option><option value="price-desc" selected="@(Model.Sort == "price-desc")">Giá giảm dần</option></select></div><div class="col-md-1"><button class="btn btn-brown w-100">Lọc</button></div></form>
<div class="row g-4">@foreach(var product in Model.Products){<partial name="_ProductCard" model="product" />}</div>
@if(Model.TotalPages > 1){<nav class="mt-4"><ul class="pagination justify-content-center">@for(var p=1;p<=Model.TotalPages;p++){<li class="page-item @(p==Model.Page?"active":"")"><a class="page-link" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-sort="@Model.Sort">@p</a></li>}</ul></nav>}
